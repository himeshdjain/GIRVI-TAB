# ============================================================
# Digital Girvi - Environment Configuration
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_girvi
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_SSL=false
# Maximum number of clients in the pool
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_hex_secret_access
JWT_REFRESH_SECRET=replace_with_64_byte_hex_secret_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Encryption (for TOTP secrets & sensitive fields) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_32_byte_hex_encryption_key

# --- Bcrypt ---
BCRYPT_ROUNDS=12

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=./logs

# --- SMS (optional) ---
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (optional) ---
EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@digitalgirvi.local

# --- Session / Cookie ---
COOKIE_SECRET=replace_with_random_cookie_secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
